# Path to the local SQLite database file used by src/db/client.ts.
# Defaults to ./data/app.db when unset.
DATABASE_PATH=./data/app.db

# Auth.js v5 (src/auth/config.ts). Generate with: npx auth secret
# NEVER commit a real value — placeholder only.
AUTH_SECRET=changeme

# Discord OAuth app credentials (https://discord.com/developers/applications).
# NEVER commit real values — placeholders only.
AUTH_DISCORD_ID=changeme
AUTH_DISCORD_SECRET=changeme
